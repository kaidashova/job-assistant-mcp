# Where the SQLite database lives (default: ~/.job-assistant/jobs.db, /data/jobs.db in Docker)
JOB_ASSISTANT_DB=./data/jobs.db
# Transport: stdio (default, for Claude Desktop / Claude Code) or streamable-http
MCP_TRANSPORT=stdio
MCP_HOST=127.0.0.1
MCP_PORT=8000
# Timeout (seconds) for requests to the job boards
JOB_ASSISTANT_HTTP_TIMEOUT=20
